# WablastXl local development / Railway reference profile
# Use this as a reference only; never commit real secrets.
NODE_ENV=production
PORT=2785
TZ=Asia/Jakarta
AUTO_START_SESSIONS=true

# Initial deployment uses local SQLite on the persistent /app/data volume.
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=false

ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Optional hardening:
# Set API_MASTER_KEY only through the hosting provider's secret manager.
# Do not store API keys in source control, browser bundles, or public logs.
